---
import { SITE } from '../data/site';
import { url } from '../lib/url';
---

<footer class="relative overflow-hidden bg-sea-950 text-white">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-chili/60 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -left-24 top-10 h-64 w-64 rounded-full bg-sea-700/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-16 bottom-0 h-56 w-56 rounded-full bg-chili/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="container-site relative grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="mb-5 flex items-center gap-3">
        <img
          src={url('/images/logo.webp')}
          alt=""
          width="48"
          height="48"
          class="h-12 w-12 rounded-full bg-white object-contain p-1 shadow-sm"
          loading="lazy"
        />
        <span class="font-display text-xl font-bold tracking-tight" data-i18n="brand">{SITE.name}</span>
      </div>
      <p class="max-w-sm text-base leading-relaxed text-white/70" data-i18n="hero.subtitle">
        Experience Calabria through local eyes
      </p>
    </div>

    <div>
      <h2 class="mb-4 font-display text-lg tracking-tight" data-i18n="contactInfo.title">Contact Us</h2>
      <ul class="space-y-2.5 text-white/75">
        <li>
          <a class="text-inherit no-underline transition hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <a class="text-inherit no-underline transition hover:text-white" href={url('/#contact')} data-i18n="nav.book">Book</a>
        </li>
        <li>
          <a class="text-inherit no-underline transition hover:text-white" href={url('/itinerary')} data-i18n="nav.itineraries">Itinerary</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="mb-4 font-display text-lg tracking-tight">Follow</h2>
      <div class="flex gap-3">
        <a class="footer-social" href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a class="footer-social" href={`mailto:${SITE.email}`} aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </a>
        <a class="footer-social" href={SITE.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a class="footer-social" href={SITE.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="relative border-t border-white/10">
    <p class="container-site py-5 text-sm text-white/45">{SITE.copyright}</p>
  </div>
</footer>
