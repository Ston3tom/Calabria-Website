---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Calabria Essence — Experience Calabria through local eyes"
  description="Authentic 6-day Calabria journeys with Lorenzo & Kristýna. Beaches, cuisine, culture, and small-group experiences designed by locals. From 22.490 Kč."
  path="/"
>
  <Header />
  <main id="main">
    <section class="hero-full">
      <img
        src={url('/images/main_background.webp')}
        alt="Coastal town in Calabria at dusk"
        class="hero-media"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="container-site relative z-10 pb-16 pt-32 md:pb-24 md:pt-40">
        <p class="mb-4 text-xs font-bold tracking-[0.22em] text-white/75 uppercase" data-i18n="offer.badge">
          6 days · guided by locals
        </p>
        <h1 class="font-display text-5xl font-extrabold tracking-tight text-white md:text-7xl lg:text-8xl" data-i18n="brand">
          Calabria Essence
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/90 md:text-xl" data-i18n="hero.subtitle">
          Experience Calabria through local eyes
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#contact" class="btn btn-primary" data-i18n="nav.book">Book</a>
          <a href={url('/itinerary')} class="btn btn-secondary" data-i18n="trips.viewItineraries">View itinerary</a>
        </div>
        <dl class="hero-offer-strip text-white/90">
          <div class="hero-offer-item">
            <dt data-i18n="offer.fromLabel">From</dt>
            <dd data-i18n="offer.priceShort">22.490 Kč</dd>
          </div>
          <div class="hero-offer-item">
            <dt data-i18n="offer.groupLabel">Group</dt>
            <dd data-i18n="offer.group">Max 10</dd>
          </div>
          <div class="hero-offer-item">
            <dt data-i18n="offer.seasonLabel">Season</dt>
            <dd data-i18n="offer.season">May–July</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="experience" class="section-pad">
      <div class="container-site">
        <div class="reveal mb-12 max-w-2xl">
          <p class="eyebrow" data-i18n="why.eyebrow">The experience</p>
          <h2 class="font-display text-4xl tracking-tight text-sea-950 md:text-5xl" data-i18n="why.title">Why Calabria?</h2>
          <p class="mt-4 text-lg text-muted" data-i18n="why.lead">
            Sea, table, and tradition — three sides of the same place, shown the way locals actually live it.
          </p>
        </div>
        <div class="grid gap-5 md:grid-cols-3 md:gap-6">
          <a href={url('/beaches')} class="feature-tile reveal md:min-h-[420px]">
            <img src={url('/images/beach_section.webp')} alt="Calabrian beach with clear water" loading="lazy" />
            <div class="feature-tile-body">
              <h3 class="font-display text-2xl md:text-3xl" data-i18n="why.beach">Beaches</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/85 md:text-base" data-i18n="why.beach_desc">
                Untouched coves and turquoise water — a different shore almost every day.
              </p>
              <span class="tile-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
          <a href={url('/food')} class="feature-tile reveal reveal-delay-1 md:min-h-[420px]">
            <img
              src={url('/images/food_section.webp')}
              alt="Calabrian cuisine"
              class="object-top"
              loading="lazy"
            />
            <div class="feature-tile-body">
              <h3 class="font-display text-2xl md:text-3xl" data-i18n="why.food">Food</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/85 md:text-base" data-i18n="why.food_desc">
                Family recipes, ’nduja, fresh seafood, and a pasta class you’ll still talk about later.
              </p>
              <span class="tile-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
          <a href={url('/culture')} class="feature-tile reveal reveal-delay-2 md:min-h-[420px]">
            <img src={url('/images/culture_section.webp')} alt="Historic village in Calabria" loading="lazy" />
            <div class="feature-tile-body">
              <h3 class="font-display text-2xl md:text-3xl" data-i18n="why.culture">Culture</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/85 md:text-base" data-i18n="why.culture_desc">
                Hill towns, Greek roots, and living traditions — Calabria beyond the postcard.
              </p>
              <span class="tile-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section-pad relative overflow-hidden bg-sea-950 text-white">
      <div class="pointer-events-none absolute -right-20 top-10 h-72 w-72 rounded-full bg-sea-700/25 blur-3xl" aria-hidden="true"></div>
      <div class="container-site relative grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="reveal media-frame overflow-hidden rounded-[1.6rem] shadow-[0_30px_80px_rgba(0,0,0,0.35)]">
          <img
            src={url('/images/aboutus_section.webp')}
            alt="Lorenzo and Kristýna"
            class="aspect-[4/5] w-full object-cover object-[42%_center]"
            loading="lazy"
          />
        </div>
        <div class="reveal reveal-delay-1">
          <p class="eyebrow !text-sea-100/75">About</p>
          <h2 class="font-display text-4xl tracking-tight md:text-5xl" data-i18n="about.previewTitle">Meet Lorenzo & Kristýna</h2>
          <p class="mt-5 text-lg leading-relaxed text-white/75" data-i18n="about.previewText">
            An Italian–Czech couple sharing authentic Calabria through local eyes.
          </p>
          <a href={url('/about')} class="btn btn-primary mt-9" data-i18n="about.clickToRead">Read our story</a>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-site">
        <div class="reveal editorial-panel md:grid md:grid-cols-[1.15fr_0.85fr]">
          <div class="relative min-h-[300px] md:min-h-[420px]">
            <img
              src={url('/images/tripservices_section.webp')}
              alt="Calabria trip experience"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-sea-950/70 via-sea-950/25 to-transparent md:bg-gradient-to-t md:from-sea-950/40 md:via-transparent md:to-transparent"></div>
          </div>
          <div class="flex flex-col justify-center p-8 md:p-12">
            <p class="eyebrow !text-white/65" data-i18n="offer.badge">6 days · guided by locals</p>
            <h2 class="font-display text-3xl tracking-tight md:text-4xl" data-i18n="trips.exploreTitle">The itinerary</h2>
            <ul class="highlight-list mt-6">
              <li data-i18n="itineraries.svcDriver">Private driver throughout</li>
              <li data-i18n="itineraries.svcPension">Full board</li>
              <li data-i18n="itineraries.svcGroup">Small group (10 max)</li>
              <li data-i18n="offer.priceLine">From 22.490 Kč per person</li>
            </ul>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href={url('/itinerary')} class="btn btn-primary" data-i18n="trips.viewItineraries">View itinerary</a>
              <a href="#contact" class="btn btn-secondary" data-i18n="nav.book">Book</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
